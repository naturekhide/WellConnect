generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  username      String?   @unique
  expoPushToken String?
  notificationPreference NotificationPreference?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  

  moodEntries   MoodEntry[]
  journalEntries JournalEntry[]
  goals         Goal[]
  insights      Insight[]
  patterns      UserPattern[]
  achievements  Achievement[]
  notifications Notification[]
  feedPosts  FeedPost[] @relation("FeedAuthor")
  feedReactions FeedReaction[]
  feedReplies  FeedReply[]
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  label     String
  note      String?
  source    String   @default("checkin")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([userId, createdAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  sentiment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  frequency   String   @default("daily")
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Insight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String
  actionLink  String?
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model UserPattern {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  dayOfWeek Int
  hour      Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  unlockedAt  DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // achievement, insight, streak, goal, system
  title       String
  body        String
  link        String?  // deep link e.g. /achievements, /(tabs)/journal
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckin       Boolean  @default(true)
  checkinTime        String   @default("09:00")  // HH:MM format
  achievements       Boolean  @default(true)
  insights           Boolean  @default(true)
  streakReminders    Boolean  @default(true)
  weeklySummary      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FeedPost {
  id         String   @id @default(cuid())
  authorId   String?
  author     User?    @relation("FeedAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  anonymous  Boolean  @default(false)
  content    String
  imageUrls  String
  sentiment  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reactions  FeedReaction[]
  replies    FeedReply[]

  @@index([createdAt])
}

model FeedReaction {
  id        String   @id @default(cuid())
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model FeedReply {
  id        String   @id @default(cuid())
  content   String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  anonymous Boolean  @default(false)
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
}